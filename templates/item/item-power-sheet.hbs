{{! This template is a fallback for when items don't have more specific templates. }}
{{! Generally, you'll want to make more specific templates when possible. }}

<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
        {{! Editors must receive enriched text data from getData to properly handle rolls }}
        {{editor (lookup (lookup system.values system.key) 'desc') target='system.desc' engine='prosemirror' button=true editable=editable}}
  </header>
      <div class="flexrow" style="gap: 0.5em;">
        <!-- LEFT COLUMN -->
        <div class="flexcol" style="flex: 1;">
            <ol class='items-list'>
              <li class='item flexrow items-header'>
                <div>Setup</div>
              </li>
                <li class='item flexrow'>
                    <div class="flexcol" style="flex: 1;">
                      <section style="text-align: left;">
                          <label class='resource-label' style="display: inline-block;width:100px;">{{localize "Name"}}</label>
                          <input style="width:250px;" type="text" name="system.name" value="{{system.name}}"/>
                      </section>
                      <section style="text-align: left;">
                          <label class='resource-label' style="display:inline-block;;width:100px;">{{localize "Power"}}</label>
                          <select style="width:250px;" name="system.key" value="{{system.key}}">
                              {{{ selectKey this.powerlist system.key }}}
                          </select>
                      </section>
                    </div>
                </li>
            </ol>
        </div>
      </div>

        <ol class='items-list'>
          <li class='item flexrow items-header'>
            <div style="flex:0 0 50px;">Lvls</div>
            <div style="text-align: left;">Name</div>
            <div>Cost</div>
          </li>

          {{#if (lookup (lookup this.powerlist system.key) 'input1')}}
            <li class='item flexrow'>
              <div class="flexcol" style="flex: 0 0 50px;">
                  <section style="text-align: left;">
                      <input type="text" name="system.input1" value="{{system.input1}}"/>
                  </section>

              </div>
              <div class='resource-label align-left' >
                  <section style="text-align: left;">
                    {{ lookup (lookup (lookup this.powerlist system.key) 'input1') 'label'}}
                  </section>
              </div>
              <div class="align-center">
                {{ calcPowerPtsTotal (lookup (lookup this.powerlist system.key) 'input1') system.input1 }}
              </div>
          </li>
          {{/if}}

        {{#if (lookup (lookup this.powerlist system.key) 'input2')}}
          <li class='item flexrow'>
            <div class="flexcol" style="flex: 0 0 50px;">
                <section style="text-align: left;">
                    <input type="text" name="system.input2" value="{{system.input2}}"/>
                </section>

            </div>
            <div class='resource-label align-left' >
                <section style="text-align: left;">
                  {{ lookup (lookup (lookup this.powerlist system.key) 'input2') 'label'}}
                </section>
            </div>
            <div class="align-center">
              {{ calcPowerPtsTotal (lookup (lookup this.powerlist system.key) 'input2') system.input2 }}
            </div>
        </li>
        {{/if}}

        {{#if (lookup (lookup this.powerlist system.key) 'input3')}}
          <li class='item flexrow'>
            <div class="flexcol" style="flex: 0 0 50px;">
                <section style="text-align: left;">
                    <input type="text" name="system.input3" value="{{system.input3}}"/>
                </section>

            </div>
            <div class='resource-label align-left' >
                <section style="text-align: left;">
                  {{ lookup (lookup (lookup this.powerlist system.key) 'input3') 'label'}}
                </section>
            </div>
            <div class="align-center">
              {{ calcPowerPtsTotal (lookup (lookup this.powerlist system.key) 'input3') system.input3 }}
            </div>
        </li>
        {{/if}}

        </ol>

</form>