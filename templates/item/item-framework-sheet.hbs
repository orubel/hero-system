{{! This template is a fallback for when items don't have more specific templates. }}
{{! Generally, you'll want to make more specific templates when possible. }}
<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
        {{! Editors must receive enriched text data from getData to properly handle rolls }}
        {{editor (lookup (lookup system.values system.key) 'desc') target='system.desc' engine='prosemirror' button=true editable=editable}}
  </header>

      <div class="flexrow" style="gap: 0.5em;">
        <!-- LEFT COLUMN -->
        <div class="flexcol" style="flex: 1;">
            <ol class='items-list'>
              <li class='item flexrow items-header'>
                <div>Setup</div>
              </li>
                <li class='item flexrow'>
                    <div class="flexcol" style="flex: 1;">
                      <section style="text-align: left;">
                          <label class='resource-label' style="display:inline-block;;width:100px;">{{localize "Framework"}}</label>
                          <select style="width:250px;" name="system.key" value="{{system.key}}">
                              {{{ selectValue this.frameworklist system.key }}}
                          </select>
                      </section>
                      <section style="text-align: left;">
                          <label class='resource-label' style="display:inline-block;;width:100px;">{{localize "Points"}}</label>
                          <input type="text" class="item-field-label-long2" name="system.points" value="{{system.points}}" data-dtype="String" />
                      </section>
                    </div>
                </li>
            </ol>
        </div>
      </div>

</form>