<form class="{{cssClass}}" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="400" width="300"/>
      <div class="flexrow" style="gap: 0.5em;">
        <!-- LEFT COLUMN -->
        <div class="flexcol" style="flex: 1;">

          <h1 class="charname "><input name="system.biodata.name" type="text" value="{{system.biodata.name}}" placeholder="Name" /></h1>

          <div class="flexrow">
            <ul class="item-list alternate-list">
              <li class="item flexrow">
                <label class="item-field-label-medium">Alternate IDs</label>
                <input type="text" class="item-field-label-long4" name="system.biodata.alternateids"
                  value="{{system.biodata.origin}}" data-dtype="String" />
              </li>
            </ul>
          </div>

          <div class="grid grid-2col">
            <div>
              <ul class="item-list alternate-list">
                <li class="flexrow item">
                  <label class="item-field-label-medium">Campaign</label>
                  <input type="text" class="item-field-label-long3" name="system.biodata.campaign"
                    value="{{system.biodata.campaign}}" data-dtype="String" />
                </li>
                <li class="flexrow item">
                  <label class="item-field-label-medium">Player</label>
                  <input type="text" class="item-field-label-long3" name="system.biodata.player"
                    value="{{system.biodata.player}}" data-dtype="String" />
                </li>
                <li class="flexrow item">
                  <label class="item-field-label-medium">GM</label>
                  <input type="text" class="item-field-label-long3" name="system.biodata.gm"
                    value="{{system.biodata.gm}}" data-dtype="String" />
                </li>
                <li class="item flexrow">
                  <label class="item-field-label-medium">Hair</label>
                  <input type="text" class="item-field-label-long3" name="system.biodata.hair"
                    value="{{system.biodata.hair}}" data-dtype="String" />
                </li>
              </ul>
            </div>
            <div>
              <ul class="item-list alternate-list">
                <li class="flexrow item">
                  <label class="item-field-label-medium">Gender</label>
                  <input type="text" class="item-field-label-medium" name="system.biodata.gender"
                    value="{{system.biodata.gender}}" data-dtype="String" />
                </li>
                <li class="item flexrow">
                  <label class="item-field-label-medium">Height</label>
                  <input type="text" class="item-field-label-medium" name="system.biodata.height"
                    value="{{system.biodata.height}}" data-dtype="String" />
                </li>
                <li class="item flexrow">
                  <label class="item-field-label-medium">Mass</label>
                  <input type="text" class="item-field-label-medium" name="system.biodata.mass"
                    value="{{system.biodata.mass}}" data-dtype="String" />
                </li>
                <li class="item flexrow">
                  <label class="item-field-label-medium">Eyes</label>
                  <input type="text" class="item-field-label-medium" name="system.biodata.eyes"
                    value="{{system.biodata.eyes}}" data-dtype="String" />
                </li>
              </ul>
            </div>
          </div>
        </div>


        <!-- RIGHT COLUMN -->
        <div class="flexcol" style="flex: 0 0 100px; grid-template-rows: 1fr 1fr 1fr; grid-template-columns: 1fr; gap: 0.25em;">
          <div style="padding:5px;border-radius: 25px; background-color: #4287f5;text-align:center;">
              <label class="resource-label" style="align:center; color:#fff;">Stun</label>
              <div class="flexrow flex-center flex-between" style="padding:10px;display: flex; align-items: center;">
                  <div>{{ system.abilities.STUN.value }} /</div>
                  <input type="text" name="system.STUN.current" value="{{calcCurrentStun system.abilities.STUN.value system.STUN.current}}" data-dtype="Number"/>
              </div>
          </div>

          <div style="padding:5px;border-radius: 25px; background-color: #4287f5;text-align:center;">
              <label class="resource-label" style="align:center; color:#fff;">BODY</label>
              <div class="flexrow flex-center flex-between" style="padding:10px; display: flex; align-items: center;">
                  <div>{{ system.abilities.BODY.value }} /</div>
                  <input type="text" name="system.BODY.current" value="{{system.BODY.value}}" data-dtype="Number"/>
              </div>
          </div>
          <div style="padding:5px;border-radius: 25px; background-color: #4287f5;text-align:center;">
              <label class="resource-label" style="align:center; color:#fff;">END</label>
              <div class="flexrow flex-center flex-between" style="padding:10px;display: flex; align-items: center;">
                  <div>{{ system.abilities.REC.value }} /</div>
                  <input type="text" name="system.END.current" value="{{system.END.value}}" data-dtype="Number"/>
              </div>
          </div>
        </div>
      </div>
  </header>

    <div class="tab" style="padding:5px;border-radius: 25px; background-color: #c1d9ff;text-align:center;">

        <ol style="margin:5px;">
          <li class='flexrow'>
            <div>
                <label class="resource-label" style="align:center; color:#000;">Chars</label>
            </div>
            <div style="flex:0 0 10px;"></div>
            <div>
                <label class="resource-label" style="align:center; color:#000;">Skills</label>
            </div>
            <div style="flex:0 0 10px;"></div>
            <div>
                <label class="resource-label" style="align:center; color:#000;">Powers</label>
            </div>
            <div style="flex:0 0 10px;"></div>
            <div>
                <label class="resource-label" style="align:center; color:#000;">Cost</label>
            </div>
            <div style="flex:0 0 100px;">
                <label class="resource-label" style="align:center; color:#000;">Free Pts</label>
            </div>
            <div>
                <label class="resource-label" style="align:center; color:#000;">Pts Avail</label>
            </div>
            <div style="flex:0 0 10px;"></div>
            <div>
                <label class="resource-label" style="align:center; color:#000;">Comps</label>
            </div>
            <div style="flex:0 0 10px;"></div>
            <div>
                <label class="resource-label" style="align:center; color:#000;">Base</label>
            </div>
            <div style="flex:0 0 10px;"></div>
            <div>
                <label class="resource-label" style="align:center; color:#000;">XP</label>
            </div>
          </li>
          <li class='flexrow'>
            <div>{{ calcCharTotal system.abilities }}</div>
            <div style="flex:0 0 10px;">+</div>
            <div>{{ calcSkillPtsTotal skills system.skilllist }}</div>
            <div style="flex:0 0 10px;">+</div>
            <div>{{ calcPowPtsTotal powers system.powerlist frameworks system.frameworklist advantages disadvantages}}</div>
            <div style="flex:0 0 10px;">=</div>

{{{ calcPts abilities skills system.skilllist powers system.powerlist frameworks system.frameworklist advantages disadvantages complications system.complicationlist system.biodata }}}

            <div style="flex:0 0 10px;">=</div>
            <div>{{ calcCompPtsTotal complications system.complicationlist }}</div>
            <div style="flex:0 0 10px;">+</div>
            <div>
                <input type="text" name="system.biodata.basePts" value="{{system.biodata.basePts}}" data-dtype="Number"/>
            </div>
            <div style="flex:0 0 10px;">+</div>
            <div>
                <input type="text" name="system.biodata.xpearned" value="{{system.biodata.xpearned}}" data-dtype="Number"/>
            </div>
          </li>
        </ol>
    </div>


  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{!-- Default tab is specified in actor-sheet.mjs --}}
    <a class="item" data-tab="chars">Characteristics</a>
    <a class="item" data-tab="background">Background</a>
    <a class="item" data-tab="combat">Combat</a>
    <a class="item" data-tab="skills">Skills</a>
    <a class="item" data-tab="perks">Perks</a>
    <a class="item" data-tab="talents">Talents</a>
    <a class="item" data-tab="complications">Complications</a>
    <a class="item" data-tab="powers">Powers</a>
    <a class="item" data-tab="items">Items</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Owned Features Tab --}}

    <div class="tab features" data-group="primary" data-tab="chars">

        <ol class='items-list'>
          <li class='item flexrow items-header'>
            <div style="flex:0 0 50px;">Value</div>
            <div style="flex:0 0 75px;">Char</div>
            <div style="flex:0 0 250px;">Base</div>
            <div style="flex:0 0 75px;">Multiplier</div>
            <div style="flex:0 0 50px;">Cost</div>
            <div style="flex:0 0 75px;">Ability Roll</div>
            <div>Notes</div>
          </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.STR.value" value="{{ system.abilities.STR.value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{localize 'STR'}}</div>
              <div class="align-center" style="flex:0 0 250px;">{{ system.abilities.[STR].base }}</div>
              <div class="align-center" style="flex:0 0 75px;">[x{{ system.abilities.[STR].cost_multiplier }}]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcStrPts system.abilities.[STR] }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <!-- example 3d6+@abilities.BODY.mod -->
                <span class="ability-mod rollable" data-roll="3d6" data-type="char" data-label="{{localize 'STR'}}"><i class="fas fa-dice"></i>{{system.abilities.STR.mod}}></span>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.STR.notes" value="{{system.abilities.STR.notes}}" data-dtype="String" />
              </div>
            </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.DEX.value" value="{{ system.abilities.[DEX].value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{localize 'DEX'}}</div>
              <div class="align-center" style="flex:0 0 250px;">{{ system.abilities.[DEX].base }}</div>
              <div class="align-center" style="flex:0 0 75px;">[x{{ system.abilities.[DEX].cost_multiplier }}]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcDexPts system.abilities.[DEX] }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <!-- example 3d6+@abilities.BODY.mod -->
                <span class="ability-mod rollable" data-roll="3d6" data-label="{{localize 'DEX'}}"><i class="fas fa-dice"></i>{{numberFormat system.abilities.DEX.mod decimals=0 sign=false}}></span>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.DEX.notes" value="{{system.abilities.DEX.notes}}" data-dtype="String" />
              </div>
            </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.CON.value" value="{{ system.abilities.[CON].value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{localize 'CON'}}</div>
              <div class="align-center" style="flex:0 0 250px;">{{ system.abilities.[CON].base }}</div>
              <div class="align-center" style="flex:0 0 75px;">[x{{ system.abilities.[CON].cost_multiplier }}]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcConPts system.abilities.[CON] }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <!-- example 3d6+@abilities.BODY.mod -->
                {{ log system.abilities.CON.mod }}
                <span class="ability-mod rollable" data-roll="3d6" data-label="{{localize 'CON'}}"><i class="fas fa-dice"></i>{{numberFormat system.abilities.CON.mod decimals=0 sign=false}}></span>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.CON.notes" value="{{system.abilities.CON.notes}}" data-dtype="String" />
              </div>
            </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.BODY.value" value="{{ system.abilities.[BODY].value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{localize 'BODY'}}</div>
              <div class="align-center" style="flex:0 0 250px;">{{ system.abilities.[BODY].base }}</div>
              <div class="align-center" style="flex:0 0 75px;">[x{{ system.abilities.[BODY].cost_multiplier }}]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcBodyPts system.abilities.[BODY] }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <!-- example 3d6+@abilities.BODY.mod -->
                <span class="ability-mod rollable" data-roll="3d6" data-label="{{localize 'BODY'}}"><i class="fas fa-dice"></i>{{numberFormat system.abilities.BODY.mod decimals=0 sign=false}}></span>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.BODY.notes" value="{{system.abilities.BODY.notes}}" data-dtype="String" />
              </div>
            </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.INT.value" value="{{ system.abilities.[INT].value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{localize 'INT'}}</div>
              <div class="align-center" style="flex:0 0 250px;">{{ system.abilities.[INT].base }}</div>
              <div class="align-center" style="flex:0 0 75px;">[x{{ system.abilities.[INT].cost_multiplier }}]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcIntPts system.abilities.[INT] }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <!-- example 3d6+@abilities.BODY.mod -->
                <span class="ability-mod rollable" data-roll="3d6" data-label="{{localize 'INT'}}"><i class="fas fa-dice"></i>{{numberFormat system.abilities.INT.mod decimals=0 sign=false}}></span>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.INT.notes" value="{{system.abilities.INT.notes}}" data-dtype="String" />
              </div>
            </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.EGO.value" value="{{ system.abilities.[EGO].value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{ localize 'EGO' }}</div>
              <div class="align-center" style="flex:0 0 250px;">{{ system.abilities.[EGO].base }}</div>
              <div class="align-center" style="flex:0 0 75px;">[x{{ system.abilities.[EGO].cost_multiplier }}]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcEgoPts system.abilities.[EGO] }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <!-- example 3d6+@abilities.BODY.mod -->
                <span class="ability-mod rollable" data-roll="3d6" data-label="{{localize 'EGO'}}"><i class="fas fa-dice"></i>{{numberFormat system.abilities.EGO.mod decimals=0 sign=false}}></span>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.EGO.notes" value="{{system.abilities.EGO.notes}}" data-dtype="String" />
              </div>
            </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.PRE.value" value="{{ system.abilities.[PRE].value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{localize 'PRE'}}</div>
              <div class="align-center" style="flex:0 0 250px;">{{ system.abilities.[PRE].base }}</div>
              <div class="align-center" style="flex:0 0 75px;">[x{{ system.abilities.[PRE].cost_multiplier }}]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcPrePts system.abilities.[PRE] }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <!-- example 3d6+@abilities.BODY.mod -->
                <span class="ability-mod rollable" data-roll="3d6" data-label="{{localize 'PRE'}}"><i class="fas fa-dice"></i>{{numberFormat system.abilities.PRE.mod decimals=0 sign=false}}></span>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.PRE.notes" value="{{system.abilities.PRE.notes}}" data-dtype="String" />
              </div>
            </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.PD.value" value="{{ system.abilities.[PD].value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{localize 'PD'}}</div>
              <div class="align-center" style="flex:0 0 250px;">STR/5</div>
              <div class="align-center" style="flex:0 0 75px;">[x1]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcPdPts system.abilities }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <h4 class="item-field-label-short margin-item-list">-</h4>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.PD.notes" value="{{system.abilities.PD.notes}}" data-dtype="String" />
              </div>
            </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.ED.value" value="{{ system.abilities.[ED].value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{localize 'ED'}}</div>
              <div class="align-center" style="flex:0 0 250px;">CON/5</div>
              <div class="align-center" style="flex:0 0 75px;">[x1]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcEdPts system.abilities }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <h4 class="item-field-label-short margin-item-list">-</h4>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.ED.notes" value="{{system.abilities.ED.notes}}" data-dtype="String" />
              </div>
            </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.SPD.value" value="{{ system.abilities.[SPD].value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{localize 'SPD'}}</div>
              <div class="align-center" style="flex:0 0 250px;">DEX/10+1</div>
              <div class="align-center" style="flex:0 0 75px;">[x10]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcSpdPts system.abilities }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <h4 class="item-field-label-short margin-item-list">-</h4>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.SPD.notes" value="{{system.abilities.SPD.notes}}" data-dtype="String" />
              </div>
            </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.REC.value" value="{{ system.abilities.[REC].value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{localize 'REC'}}</div>
              <div class="align-center" style="flex:0 0 250px;">STR/5+CON/5</div>
              <div class="align-center" style="flex:0 0 75px;">[x2]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcRecPts system.abilities }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <h4 class="item-field-label-short margin-item-list">-</h4>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.REC.notes" value="{{system.abilities.REC.notes}}" data-dtype="String" />
              </div>
            </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.END.value" value="{{ system.abilities.[END].value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{localize 'END'}}</div>
              <div class="align-center" style="flex:0 0 250px;">CONx2</div>
              <div class="align-center" style="flex:0 0 75px;">[x1/2]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcEndPts system.abilities }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <h4 class="item-field-label-short margin-item-list">-</h4>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.END.notes" value="{{system.abilities.END.notes}}" data-dtype="String" />
              </div>
            </li>
            <li class='item flexrow'>
              <div class="align-center" style="flex:0 0 50px;">
                <input type="text" name="system.abilities.STUN.value" value="{{ system.abilities.[STUN].value }}" data-dtype="Number"/>
              </div>
              <div class='resource-label align-center' style="flex:0 0 75px;">{{localize 'STUN'}}</div>
              <div class="align-center" style="flex:0 0 250px;">BODY+STR/2+CON/2</div>
              <div class="align-center" style="flex:0 0 75px;">[x2]</div>
              <div class="align-center" style="flex:0 0 50px;">
                {{ calcStunPts system.abilities }}
              </div>
              <div class="align-center" style="flex:0 0 75px;">
                <h4 class="item-field-label-short margin-item-list">-</h4>
              </div>
              <div class="align-center">
                <input type="text" class="item-field-label-long2" name="system.abilities.STUN.notes" value="{{system.abilities.STUN.notes}}" data-dtype="String" />
              </div>
            </li>

            <li class='item flexrow items-header'>
              <div class="align-center" style="flex:0 0 50px;"></div>
              <div class='resource-label align-center' style="flex:0 0 75px;"></div>
              <div class="align-center" style="flex:0 0 250px;"></div>
              <div class="align-center" style="flex:0 0 75px;"><span class="resource-label align-right">Char Total = </span></div>
              <div class="align-left" style="flex:0 0 50px;">
                {{ calcCharTotal system.abilities }}
              </div>
              <div class="align-center" style="flex:0 0 75px;"></div>
              <div class="align-center"></div>
            </li>
        </ol>
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="background">

      <h3>Personality/Motivation : </h3>
      <div class="form-group editor">
        {{editor motivation target="system.biodata.motivation" button=true owner=owner
        editable=editable}}
      </div>
      <hr>
      <h3>Quote : </h3>
      <div class="form-group editor">
        {{editor quote target="system.biodata.quote" button=true owner=owner
        editable=editable}}
      </div>
      <h3>Powers/Tactics : </h3>
