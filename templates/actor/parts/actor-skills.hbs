<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div style="flex:0 0 50px;">Pts</div>
    <div style="flex: 0 0 250px;text-align:left;">Skill</div>
    <div style="flex: 0 0 100px;text-align:left;">Type</div>
    <div style="flex: 0 0 50px;text-align:left;">Lvls</div>
    <div style="text-align:left;">Roll</div>
    <div style="text-align:right;">
      <a class='item-control skill-create' title='{{localize "DOCUMENT.Create" type='Skill'}}' data-type='skill'>
        <i class='fas fa-plus'></i>{{localize 'DOCUMENT.New' type='skill'}}
      </a>
    </div>
  </li>

  {{{ showSkills system.abilities skills system.skilllist }}}

  <li class='item flexrow items-header'>
    <div style="flex:0 0 50px;">
        {{ calcSkillPtsTotal skills system.skilllist }}
    </div>
    <div style="flex: 0 0 250px;text-align:left;">Total</div>
    <div style="flex: 0 0 100px;text-align:left;"></div>
    <div style="flex: 0 0 50px;text-align:left;"></div>
    <div style="text-align:left;"></div>
    <div style="text-align:right;"></div>
  </li>
</ol>