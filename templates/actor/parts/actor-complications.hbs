<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div>Complication</div>
    <div style="text-align:right;">
      <a class='item-control complication-create' title='{{localize "DOCUMENT.Create" type='Complication'}}' data-type='complication'>
        <i class='fas fa-plus'></i>{{localize 'DOCUMENT.New' type='complication'}}
      </a>
    </div>
  </li>
    {{#each complications as |item id|}}
      <li class='item flexrow' data-item-id='{{item._id}}'>
        <div class='item-name' style="padding:3px;">
          <h4>
            <div class='resource-label' style="display: inline-block;">{{ item.system.key }} :</div>
            <div style="display: inline-block;">{{ item.system.name }}</div>
            <div style="display: inline-block;">(

            {{#if (lookup (lookup system.values system.key) 'select1') }}
                {{ lookup (lookup (lookup (lookup system.values system.key) 'select1') 'values') system.select1}}
            {{/if}}

            {{#if (lookup (lookup system.values system.key) 'select2') }}
                ,{{ lookup (lookup (lookup (lookup system.values system.key) 'select2') 'values') system.select2}}
            {{/if}}

            {{#if (lookup (lookup system.values system.key) 'select3') }}
                ,{{ lookup (lookup (lookup (lookup system.values system.key) 'select3') 'values') system.select3}}
            {{/if}}

            {{#if (lookup (lookup system.values system.key) 'select4') }}
                ,{{ lookup (lookup (lookup (lookup system.values system.key) 'select4') 'values') system.select4}}
            {{/if}}

            )
            </div>
          </h4>
        </div>
        <div class='item-controls'>
          <a class='item-control complication-edit' title='{{localize "DOCUMENT.Update" type='Item'}}'>
            <i class='fas fa-edit'></i>
          </a>
          <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type='Item'}}'>
            <i class='fas fa-trash'></i>
          </a>
        </div>
      </li>
    {{/each}}
</ol>