    "complication": {
      "name": "New Complication",
      "key": "",
      "points": 0,
      "select1": 0,
      "select2": 0,
      "select3": 0,
      "select4": 0,
      "multiplier": 1,
      "values": {
        "Accidental Change": {
          "desc": "A character with this disadvantage will accidentally change into his superhero identity. The character defines the circumstances under which they change and how often under those circumstances they will change.",
          "select1": {
            "label": "Circumstances",
            "values": {
              "5": "uncommon",
              "10": "common",
              "15": "very common"
            }
          },
          "select2": {
            "label": "Chance to change",
            "values": {
              "0":  "occasionally (8>)" ,
              "5":  "frequently (11>)",
              "10": "often (14>)"
            }
          }
        },
        "Berserk/Enrage": {
          "desc": "A character with this disadvantage tends to go berserk during periods of stress or in canbat. Berserk characters do not know friend fran foe, and autanatically attack whoever is in front of them, until the target is knocked out or killed (whichever canes first). The Berserk character will then attack the nearest moving character in his sight. Berserk characters will use their most effective offensive power at full damage while Berserk.",
          "select1": {
            "label": "Circumstances",
            "values": {
              "5": "uncommon",
              "10": "common",
              "15": "very common"
            }
          },
          "select2": {
            "label": "Chance to Berserk",
            "values": {
              "0":  "occasionally (8>)" ,
              "5":  "frequently (11>)",
              "10": "often (14>)"
            }
          },
          "select3": {
            "label": "Chance to Recover",
            "values": {
              "0": "often (14>)",
              "5": "frequently (11>)",
              "10": "occasionally (8>)"
            }
          },
          "multiplier": {
            "label": "Type",
            "values": {
              "1": "Berserk",
              "0.5": "Enraged"
            }
          }
        },
        "Dependency": {
          "desc": "A character with this disadvantage must have a certain substance/item or they will die. The character may need water every hour or a serum every day to stay alive. ",
          "select1": {
            "label": "Substance is",
            "values": {
              "5": "uncommon",
              "10": "common",
              "15": "very common"
            }
          },
          "select2": {
            "label": "Time before taking damage",
            "values": {
              "15": "segment",
              "10": "phase",
              "5": "turn",
              "0": "minute",
              "-5": "5 minutes",
              "-10": "1 hour",
              "-15": "5 hours"
            }
          },
          "select3": {
            "label": "# of Dice",
            "values": {
              "0": "1d6",
              "5": "2d6",
              "10": "3d6"
            }
          }
        },
        "Dependent NPC": {
          "desc": "A character with this disadvantage has a non-player character friend or loved one who gets in the way and gets into trouble a lot, requiring the character to protect or save them. The character should define how competent the NPC is and hCM often the NPC gets involved in scenarios. The points for a Dependent NPC are given by the following chart.",
          "select1": {
            "label": "DNPC is",
            "values": {
              "10": "incompetent (-20 pts below norm)",
              "5": "normal",
              "0": "slightly less powerful",
              "-5": "as powerful"
            }
          },
          "select2": {
            "label": "Appears...",
            "values": {
              "5":  "occasionally (8>)" ,
              "10":  "frequently (11>)",
              "15": "often (14>)"
            }
          },
          "select3": {
            "label": "Skills",
            "values": {
              "0": "none",
              "-5": "useful noncombat skills"
            }
          }
        },
        "Distinctive Features": {
          "desc": "Distinct features can cause a negative reaction from those who view the character and make it hard for them to conceal their identity",
          "select1": {
            "label": "Concealability",
            "values": {
              "5": "easily concealed",
              "10": "concealable w/ disguise",
              "15": "not concealable"
            }
          },
          "select2": {
            "label": "Reaction",
            "values": {
              "0": "recognized",
              "5": "major reaction",
              "10": "extreme reaction"
            }
          }
        },
        "Hunted/Watched": {
          "desc": "A character with this disadvantage is hunted by some person or group in the campaign. The character may or may not know he is Hunted, at the player's discretion.",
          "select1": {
            "label": "Capabilities",
            "values": {
              "5": "less powerful",
              "10": "as powerful",
              "15": "more powerful"
            }
          },
          "select2": {
            "label": "Appearance",
            "values": {
              "5":  "occasionally (8>)" ,
              "10": "frequently (11>)",
              "15": "often (14>)"
            }
          },
          "select3": {
            "label": "Response",
            "values": {
              "-5": "Punish",
              "0": "Imprison/Kill"
            }
          },
          "multiplier": {
            "label": "Motivation",
            "values": {
              "Hunting": 1,
              "Watching": 0.5
            }
          }
        },
        "Physical Limitation": {
          "desc": "A character with this disadvantage has a physical problem which hampers him, such as lack of hands, blindness, etc. The amount of points given for a physical limitation is determined by how often the limitation gets in the way and by how damaging the limitation is.",
          "select1": {
            "label": "Occurs",
            "values": {
              "5":  "occasionally (8>)" ,
              "10": "frequently (11>)",
              "15": "often (14>)"
            }
          },
          "select2": {
            "label": "Impairs",
            "values": {
              "0": "slightly impairs",
              "5": "greatly impairs",
              "10": "fully impairs"
            }
          }
        },
        "Psychological Limitations": {
          "desc": "A character with this disadvantage has a psychological quirk about a given thing or situation. The character reacts unusually to this thing or situation, usually with fear or hatred. The character defines how often his limitation occurs and how damaging it is. The character gets points according to the following chart.",
          "select1": {
            "label": "situation is",
            "values": {
              "5": "uncommon",
              "10": "common",
              "15": "very common"
            }
          },
          "select2": {
            "label": "Intensity",
            "values": {
              "0": "moderate reaction",
              "5": "strong reaction",
              "10": "total collapse"
            }
          }
        },
        "Secret Identity": {
          "desc": "A character with this disadvantage has a well kept identity as a normal person. He leads a life as a normal person, with a job, friends, house, etc. until he changes into his superhero form. A character with this disadvantage will go to great lengths to protect his secre~. The character feels (often, quite correctly) that if .he was known to be.a superhero, his family and f!iends would be .in constant danger from supervillains. A Secret Identity is worth a bonus of 15 pts.",
          "select1": {
            "label": "Value",
            "values": {
              "15": "identity (secret)"
            }
          }
        },
        "Susceptibility": {
          "desc": "A character with this disadvantage takes damage from objects or effects that are harmless to most people. The character defines how often the damaging object or effect is encountered, and how much damage the character will take from it.",
          "select1": {
            "label": "Condition is",
            "values": {
              "5": "uncommon",
              "10": "common",
              "15": "very common"
            }
          },
          "select2": {
            "label": "Damage every",
            "values": {
              "15": "dmg per segment",
              "10": "dmg per phase",
              "5": "dmg per turn",
              "0": "dmg per minute",
              "-5": "5 minutes",
              "-10": "dmg per 1 hour",
              "-15": "dmg per 5 hours"
            }
          },
          "select3": {
            "label": "# of Dice",
            "values": {
              "0": "1d6",
              "5": "2d6",
              "10": "3d6"
            }
          }
        },
        "Unluck": {
          "desc": "A character with this disadvantage has improbable, unlucky things happen to him. The GM should ask the character to make an Unluck Roll when the character is winning easily in a fight, depending on a sure thing, taking a simple task for grant~d, etc. The GM should be careful not to overemphas7ze this disadvantage, as Unluck can be most frustrating and annoying. The character rolls 1D6 for every. 5 pts. of Unluck. Each \"l\" that appears on the dice counts as one level of Unluck. The more levels of Unluck, the more intense the effects should be. The following chart gives some suggested effects for Unluck.",
          "select1": {
            "label": "Levels",
            "values": {
              "5": "one level",
              "10": "two levels",
              "15": "three levels",
              "20": "four levels"
            }
          }
        },
        "Vulnerability": {
          "desc": "A character who takes a vulnerability takes additional damage from certain attack types. For example, a character who takes 1.5 damage from telekinesis would multiply the attack damage by 1.5. ",
          "select1": {
            "label": "Attack is",
            "values": {
              "5": "uncommon",
              "10": "common",
              "15": "very common"
            }
          },
          "multiplier": {
            "label": "Multiplier",
            "values": {
              "1": "1.5x damage (1x)",
              "2": "2x damage (2x)"
            }
          }
        }
      }
